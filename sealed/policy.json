{
  "version": "sealed-policy-1",
  "note": "Declared decision table. Every action is a mock recommendation; nothing is ever executed. Rules only raise the action: the result is the highest action among the rules that fire, or default_action when none fires. A condition on a count holds when any reported count lies within [min, max].",
  "default_action": "allow",
  "action_rules": [
    {"id": "R00", "kind": "no_evidence", "action": "monitor", "text": "no recognised signal, so keep watching rather than act"},

    {"id": "R01", "family": "credential-stuffing", "action": "monitor", "text": "3 or more failed sign-in attempts",
     "all": [{"signal": "failed_attempts", "min": 3}]},
    {"id": "R02", "family": "credential-stuffing", "action": "step-up", "text": "5 or more failed sign-in attempts",
     "all": [{"signal": "failed_attempts", "min": 5}]},
    {"id": "R03", "family": "credential-stuffing", "action": "contain", "text": "a success after 5 or more failed attempts",
     "all": [{"signal": "failed_attempts", "min": 5}, {"signal": "success_after_failures"}]},
    {"id": "R04", "family": "credential-stuffing", "action": "step-up", "text": "a tried password is on a breach list",
     "all": [{"signal": "breached_password"}]},
    {"id": "R05", "family": "credential-stuffing", "action": "monitor", "text": "the account was locked",
     "all": [{"signal": "account_locked"}]},
    {"id": "R06", "family": "context", "action": "monitor", "text": "an automated client",
     "all": [{"signal": "automated_client"}]},
    {"id": "R07", "family": "context", "action": "monitor", "text": "an anonymising proxy or Tor exit node",
     "all": [{"signal": "anonymising_proxy"}]},
    {"id": "R08", "family": "context", "action": "monitor", "text": "a device not seen before",
     "all": [{"signal": "new_device"}]},

    {"id": "R10", "family": "impossible-travel", "action": "step-up", "text": "impossible travel",
     "all": [{"signal": "impossible_travel"}]},
    {"id": "R11", "family": "impossible-travel", "action": "monitor", "text": "a sign-in from a new country",
     "all": [{"signal": "new_country"}]},
    {"id": "R12", "family": "impossible-travel", "action": "contain", "text": "impossible travel with 2 or more concurrent sessions",
     "all": [{"signal": "impossible_travel"}, {"signal": "concurrent_sessions", "min": 2}]},

    {"id": "R20", "family": "mfa-fatigue", "action": "monitor", "text": "5 or more MFA push prompts",
     "all": [{"signal": "mfa_push_requests", "min": 5}]},
    {"id": "R21", "family": "mfa-fatigue", "action": "step-up", "text": "10 or more MFA push prompts and a new device",
     "all": [{"signal": "mfa_push_requests", "min": 10}, {"signal": "new_device"}]},
    {"id": "R22", "family": "mfa-fatigue", "action": "contain", "text": "an MFA prompt approved after 5 or more prompts",
     "all": [{"signal": "mfa_push_requests", "min": 5}, {"signal": "mfa_approved"}]},
    {"id": "R23", "family": "mfa-fatigue", "action": "step-up", "text": "a new MFA method registered from a new device",
     "all": [{"signal": "mfa_method_added"}, {"signal": "new_device"}]},

    {"id": "R30", "family": "privilege-change", "action": "monitor", "text": "administrator privileges granted",
     "all": [{"signal": "privilege_granted"}]},
    {"id": "R31", "family": "privilege-change", "action": "step-up", "text": "administrator privileges granted by the same account",
     "all": [{"signal": "privilege_granted"}, {"signal": "self_granted"}]},
    {"id": "R32", "family": "privilege-change", "action": "step-up", "text": "a new administrator account",
     "all": [{"signal": "new_admin_account"}]},
    {"id": "R33", "family": "privilege-change", "action": "step-up", "text": "MFA turned off",
     "all": [{"signal": "mfa_disabled"}]},
    {"id": "R34", "family": "privilege-change", "action": "step-up", "text": "audit logging disabled or cleared",
     "all": [{"signal": "audit_logging_disabled"}]},
    {"id": "R35", "family": "privilege-change", "action": "contain", "text": "a self-approved change with audit logging disabled",
     "all": [{"signal": "self_granted"}, {"signal": "audit_logging_disabled"}]},
    {"id": "R36", "family": "privilege-change", "action": "monitor", "text": "a sensitive group modified",
     "all": [{"signal": "sensitive_group"}]},
    {"id": "R37", "family": "privilege-change", "action": "monitor", "text": "5 or more group membership changes",
     "all": [{"signal": "group_changes", "min": 5}]},

    {"id": "R40", "family": "beaconing", "action": "monitor", "text": "a regular beacon interval",
     "all": [{"signal": "regular_beacon"}]},
    {"id": "R41", "family": "beaconing", "action": "step-up", "text": "a regular beacon to a rare destination",
     "all": [{"signal": "regular_beacon"}, {"signal": "rare_destination"}]},
    {"id": "R42", "family": "beaconing", "action": "step-up", "text": "DNS tunnelling",
     "all": [{"signal": "dns_tunnelling"}]},
    {"id": "R43", "family": "beaconing", "action": "contain", "text": "a regular beacon to a rare destination with 500 or more callbacks",
     "all": [{"signal": "regular_beacon"}, {"signal": "rare_destination"}, {"signal": "callback_count", "min": 500}]},

    {"id": "R50", "family": "bulk-download", "action": "monitor", "text": "a bulk download",
     "all": [{"signal": "bulk_download"}]},
    {"id": "R51", "family": "bulk-download", "action": "monitor", "text": "500 or more files downloaded",
     "all": [{"signal": "files_downloaded", "min": 500}]},
    {"id": "R52", "family": "bulk-download", "action": "step-up", "text": "a bulk download of sensitive files",
     "all": [{"signal": "bulk_download"}, {"signal": "sensitive_files"}]},
    {"id": "R53", "family": "bulk-download", "action": "step-up", "text": "files shared or uploaded outside the organisation",
     "all": [{"signal": "external_share"}]},
    {"id": "R54", "family": "bulk-download", "action": "step-up", "text": "sensitive files copied to USB",
     "all": [{"signal": "usb_copy"}, {"signal": "sensitive_files"}]},
    {"id": "R55", "family": "bulk-download", "action": "contain", "text": "100 or more files, some sensitive, shared outside the organisation",
     "all": [{"signal": "sensitive_files"}, {"signal": "external_share"}, {"signal": "files_downloaded", "min": 100}]}
  ],
  "contradiction_rules": [
    {"id": "C01", "text": "The device is reported as both new and known.",
     "all": [{"signal": "new_device"}, {"signal": "known_device"}]},
    {"id": "C02", "text": "Impossible travel is reported together with the usual location.",
     "all": [{"signal": "impossible_travel"}, {"signal": "usual_location"}]},
    {"id": "C03", "text": "A success after failures is reported with zero failed attempts.",
     "all": [{"signal": "success_after_failures"}, {"signal": "failed_attempts", "max": 0}]},
    {"id": "C04", "text": "An approved MFA prompt is reported with zero prompts sent.",
     "all": [{"signal": "mfa_approved"}, {"signal": "mfa_push_requests", "max": 0}]},
    {"id": "C05", "text": "A bulk download is reported with zero files downloaded.",
     "all": [{"signal": "bulk_download"}, {"signal": "files_downloaded", "max": 0}]},
    {"id": "C06", "text": "A regular beacon is reported with fewer than 2 callbacks.",
     "all": [{"signal": "regular_beacon"}, {"signal": "callback_count", "max": 1}]},
    {"id": "C07", "text": "Impossible travel is reported, but traffic left through the corporate VPN, which can explain it.",
     "all": [{"signal": "impossible_travel"}, {"signal": "corporate_vpn"}]},
    {"id": "C08", "text": "A regular beacon is reported to an allowlisted destination.",
     "all": [{"signal": "regular_beacon"}, {"signal": "allowlisted_destination"}]},
    {"id": "C09", "text": "A privilege change is reported together with an approved change ticket.",
     "all": [{"signal": "privilege_granted"}, {"signal": "change_ticket"}]},
    {"id": "C10", "kind": "inconsistent_counts", "text": "The same signal is reported with different counts."}
  ],
  "uncertainty": {
    "levels": ["low", "medium", "high"],
    "rules": [
      {"id": "U1", "when": "signals_missing", "add": 2, "text": "No signals were provided."},
      {"id": "U2", "when": "no_signal_recognised", "add": 2, "text": "None of the signals matched the vocabulary."},
      {"id": "U3", "when": "some_signals_unrecognised", "add": 1, "text": "Some signals did not match the vocabulary."},
      {"id": "U4", "when": "unknown_severity", "add": 1, "text": "The severity is missing or not one the policy knows."},
      {"id": "U5", "when": "input_action_unrecognised", "add": 1, "text": "The alert's own suggested action is missing or not recognised."},
      {"id": "U6", "when": "input_action_disagrees", "add": 1, "text": "The alert's own suggested action differs from the policy's."},
      {"id": "U7", "when": "injection_evidence", "add": 1, "text": "A free-text field holds instruction-like text."},
      {"id": "U8", "when": "contradiction", "add": 1, "text": "Each contradiction rule that fires adds one level."}
    ]
  },
  "injection_escalation": {"threshold": 0.5, "max_raise": 1, "ceiling": "step-up"}
}
